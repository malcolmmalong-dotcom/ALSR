# Gmail SMTP defaults. Set credentials to a Gmail account and its Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_TO=malcolmmalong@gmail.com
# Optional; defaults to SMTP_USER
# EMAIL_FROM=

# Optional Supabase persistence. Set both values to enable it.
# Create the database table and private photo bucket with the SQL in supabase/migrations/.
SUPABASE_URL=
# Use the server-side service_role key only. Never put it in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional; defaults to service-request-photos
SUPABASE_PHOTOS_BUCKET=service-request-photos
